# Copy to .env.local and fill in values from the Firebase console
# (Project settings > General > Your apps > Web app config).
# With no config (or VITE_USE_FIREBASE_EMULATOR=true) the app connects
# to the local Firebase Emulator Suite instead.
# IMPORTANT: for a production build/deploy, set this to false or delete it —
# "true" forces the emulator even when the real config below is present.

VITE_USE_FIREBASE_EMULATOR=false

# Emulator ports (must match firebase.json; moved off the defaults
# 9099/8080 because they were already in use on the dev machine).
VITE_EMULATOR_AUTH_PORT=9199
VITE_EMULATOR_FIRESTORE_PORT=8180

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=koejon-3059e
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
