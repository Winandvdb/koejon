rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roomHost(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data.hostUid;
    }
    function isHost(code) {
      return signedIn() && roomHost(code) == request.auth.uid;
    }

    match /rooms/{code} {
      // Join-by-code needs a single-doc read. Listing room codes stays closed
      // so nobody can enumerate and squat open lobbies.
      allow get: if signedIn();
      allow list: if false;
      // The creator becomes the host; fresh rooms start at version 1.
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.version == 1;
      // Only the host mutates the room (host-authoritative design).
      // Every state change must bump the version by exactly one: a second host
      // instance on the same uid is fenced out instead of corrupting the room.
      // Heartbeat-only writes are exempt so stale detection keeps working.
      allow update: if isHost(code) && (
        request.resource.data.version == resource.data.version + 1 ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartbeat']));
      allow delete: if isHost(code);

      // Per-player hand documents. Only the host writes hand docs — it deals the cards and must mask the
      // dealer's hand during bidding. Players may read only their own doc;
      // the host may read all (it dealt them and cleans them up on teardown).
      match /hands/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow write: if isHost(code);
      }

      // A player may create/overwrite only their own intent doc.
      // The host reads and deletes intents after processing them.
      match /actions/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      // WebRTC signaling. A guest writes only the offer in its own doc, so the
      // host knows which uid sits behind each data channel; only the host
      // writes the answer.
      match /rtc/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['offer', 'offerTs']);
        allow update: if signedIn() && (
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'offerTs'])) ||
          (isHost(code)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answerFor'])));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }
    }

    // Finished matches as KJN records (see README). Write-once: the app never
    // reads, changes or deletes them. Every build still in use writes here, and
    // the rules deploy only from main, so check only what must never change:
    // auth, write-once, size and a format tag. The record shape is tested in
    // tests/kjn.test.ts. Records are untrusted input for analysis.
    match /games/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['format', 'kjn'])
        && request.resource.data.keys().size() <= 12
        && request.resource.data.format is string
        && request.resource.data.format.matches('KJN/[0-9]+')
        && request.resource.data.kjn is string
        && request.resource.data.kjn.size() <= 100000;
      allow read, update, delete: if false;
    }
  }
}
